---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { profile } from "../../data/profile.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("id-ID", { month: "long", year: "numeric" }).format(d);
---

<BaseLayout
  title={`Projects & Studi Kasus ${profile.name}`}
  description="Studi kasus proyek, arsitektur, dan catatan teknis dari Aji Kamaludin seputar perancangan sistem dan pipeline data."
>
  <header class="max-w-[65ch]">
    <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em]">
      Projects
    </h1>
    <p class="mt-5 text-[clamp(1rem,1.5vw,1.125rem)] leading-relaxed text-fg-muted">
      Studi kasus proyek dan demo yang pernah dikerjakan.
      Untuk produk yang dipakai orang lain, lihat{" "}
      <a
        href="/products/"
        class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
      >
        halaman produk
      </a>.
    </p>
  </header>

  {
    projects.length === 0 ? (
      <div class="mt-14 border-t border-border-subtle pt-6">
        <p class="text-[15px] leading-relaxed text-fg-muted">
          Belum ada project yang ditampilkan. Untuk produk yang sedang berjalan, lihat{" "}
          <a
            href="/products/"
            class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
          >
            halaman produk
          </a>
          ; untuk riwayat pekerjaan, ada di{" "}
          <a
            href="/about/#pengalaman"
            class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
          >
            about
          </a>.
        </p>
      </div>
    ) : (
  <ol class="mt-14 space-y-12">
    {
      projects.map((project) => (
        <li class="grid grid-cols-1 gap-6 border-t border-border-subtle pt-8 sm:grid-cols-12 sm:items-start">
          {project.data.cover && (
            <a
              href={`/projects/${project.id}/`}
              class="group block overflow-hidden rounded-xl border border-border-subtle bg-surface-raised transition-transform duration-200 hover:-translate-y-0.5 sm:col-span-5"
              tabindex="-1"
              aria-hidden="true"
            >
              <Image
                src={project.data.cover}
                alt={project.data.coverAlt ?? `Screenshot antarmuka ${project.data.title}`}
                widths={[400, 800]}
                sizes="(max-width: 640px) 100vw, 360px"
                class="aspect-[16/10] w-full object-cover transition-opacity duration-200 group-hover:opacity-90"
              />
            </a>
          )}

          <div class={project.data.cover ? "flex flex-col sm:col-span-7" : "flex flex-col sm:col-span-12"}>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm text-fg-muted">
              <span class="font-mono tabular-nums">{fmt(project.data.pubDate)}</span>
              <span class="rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-accent">
                {project.data.status === "live" ? "Live Demo" : project.data.status}
              </span>
            </div>

            <h2 class="mt-2 text-[clamp(1.15rem,2.2vw,1.4rem)] font-semibold leading-snug tracking-tight">
              <a
                href={`/projects/${project.id}/`}
                class="underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
              >
                {project.data.title}
              </a>
            </h2>

            <p class="mt-2 max-w-[65ch] text-[15px] leading-relaxed text-fg-muted">
              {project.data.description}
            </p>

            {project.data.stack.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[12px] text-fg-muted">
                {project.data.stack.map((s) => (
                  <span>{s}</span>
                ))}
              </p>
            )}

            <div class="mt-4 flex flex-wrap gap-3">
              <a
                href={`/projects/${project.id}/`}
                class="inline-flex min-h-9 items-center text-sm font-medium text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
              >
                Baca Studi Kasus &rarr;
              </a>
              {project.data.demoUrl && (
                <a
                  href={project.data.demoUrl}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex min-h-9 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
                >
                  Live Demo &#8599;
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
  )
  }
</BaseLayout>
