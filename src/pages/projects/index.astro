---
import { getCollection } from "astro:content";
import { profile } from "../../data/profile.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("id-ID", { month: "long", year: "numeric" }).format(d);
---

<BaseLayout
  title={`Projects & Studi Kasus ${profile.name}`}
  description="Studi kasus proyek, demo, dan catatan teknis dari Aji Kamaludin. Belum ada yang dipublikasikan di sini — lihat halaman produk atau riwayat pekerjaan."
>
  <header class="max-w-[65ch]">
    <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em]">
      Projects
    </h1>
    <p class="mt-5 text-[clamp(1rem,1.5vw,1.125rem)] leading-relaxed text-fg-muted">
      Studi kasus proyek dan demo yang pernah dikerjakan.
      Untuk produk yang dipakai orang lain, lihat{" "}
      <a
        href="/products/"
        class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
      >
        halaman produk
      </a>.
    </p>
  </header>

  {
    projects.length === 0 ? (
      <div class="mt-14 border-t border-border-subtle pt-6">
        <p class="text-[15px] leading-relaxed text-fg-muted">
          Belum ada project yang ditampilkan. Untuk produk yang sedang berjalan, lihat{" "}
          <a
            href="/products/"
            class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
          >
            halaman produk
          </a>
          ; untuk riwayat pekerjaan, ada di{" "}
          <a
            href="/about/#pengalaman"
            class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
          >
            about
          </a>.
        </p>
      </div>
    ) : (
  <ol class="mt-14 space-y-10">
    {
      projects.map((project) => (
        <li class="border-t border-border-subtle pt-6">
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm text-fg-muted">
            <span class="font-mono tabular-nums">{fmt(project.data.pubDate)}</span>
            <span>{project.data.status === "live" ? "berjalan" : project.data.status}</span>
          </div>

          <h2 class="mt-2 text-[clamp(1.2rem,2.4vw,1.5rem)] font-semibold leading-snug tracking-tight">
            <a
              href={`/projects/${project.id}/`}
              class="underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
            >
              {project.data.title}
            </a>
          </h2>

          <p class="mt-2 max-w-[65ch] text-[15px] leading-relaxed text-fg-muted">
            {project.data.description}
          </p>

          {project.data.stack.length > 0 && (
            <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[12px] text-fg-muted">
              {project.data.stack.map((s) => (
                <span>{s}</span>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ol>
  )
  }
</BaseLayout>
