---
import { getCollection, render } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<PostLayout
  title={project.data.title}
  description={project.data.description}
  pubDate={project.data.pubDate}
  tags={project.data.stack}
  cover={project.data.cover}
  coverAlt={project.data.coverAlt}
>
  {
    (project.data.demoUrl || project.data.repo || project.data.credentials) && (
      <div class="not-prose mb-10 rounded-2xl border border-border-subtle bg-surface-raised p-5 sm:p-6">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-accent">
          Akses Demo & Sumber Kode
        </h2>
        <div class="mt-4 flex flex-wrap gap-3">
          {project.data.demoUrl && (
            <a
              href={project.data.demoUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center justify-center rounded-lg bg-accent px-5 py-2.5 text-sm font-medium text-surface transition-opacity hover:opacity-90"
            >
              Buka Live Demo
            </a>
          )}
          {project.data.repo && (
            <a
              href={project.data.repo}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center justify-center rounded-lg border border-border-control px-5 py-2.5 text-sm font-medium text-fg transition-colors hover:border-accent hover:text-accent"
            >
              Repositori GitHub
            </a>
          )}
        </div>
        {project.data.credentials && (
          <p class="mt-4 border-t border-border-subtle pt-3 text-sm text-fg-muted">
            <span class="font-medium text-fg">Kredensial Demo:</span>{" "}
            <code class="rounded bg-surface-base px-2 py-0.5 font-mono text-xs text-accent">
              {project.data.credentials}
            </code>
          </p>
        )}
      </div>
    )
  }

  <Content />

  <p slot="after" class="mt-14 border-t border-border-subtle pt-6">
    <a
      href="/projects/"
      class="text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
    >
      Kembali ke semua project
    </a>
  </p>
</PostLayout>
