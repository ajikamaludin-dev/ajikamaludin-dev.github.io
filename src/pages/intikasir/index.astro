---
import { Image } from "astro:assets";
import logo from "../../assets/intikasir/logo.png";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile.ts";
import { intikasirTagline } from "../../data/products.ts";

const waNumber = profile.contacts.whatsapp;
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Halo, saya ingin bertanya soal Intikasir.",
)}`;
const email = profile.contacts.email;

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Intikasir",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Android",
  inLanguage: "id",
  description:
    "Aplikasi kasir Android offline untuk warung dan UMKM: penjualan, stok, dan uang masuk–keluar di satu aplikasi. Gratis, tanpa langganan, open source GPL-3.0.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "IDR" },
  author: { "@type": "Person", name: profile.name, url: profile.site },
};

const problems = [
  {
    problem: "Catatan masih di kertas, stok bisa kosong tanpa terasa",
    solution: "Setiap jualan tercatat dan stok terpotong otomatis.",
  },
  {
    problem: "Uang masuk dan keluar campur, akhir bulan bingung",
    solution: "Semua aliran uang usaha tercatat rapi di satu tempat.",
  },
  {
    problem: "Pemilik merangkap kasir, tidak sempat pembukuan",
    solution: "Cukup scan, tekan lunas, cetak struk — selesai.",
  },
  {
    problem: "Harga dan stok berubah-ubah, untungnya tidak jelas",
    solution: "Laporan penjualan dan laba/rugi (estimasi) tersaji kapan saja.",
  },
];

const features = [
  {
    title: "Kasir cepat",
    body: "Cari produk atau scan barcode kamera (EAN-13, EAN-8, Code 128) dan hitung kembalian otomatis.",
  },
  {
    title: "Pembayaran fleksibel",
    body: "Tunai dan QRIS Static (gambar QR merchant tampil di layar pembayaran) aktif default; transfer, EDC, e-wallet, kasbon, dan pembelian tempo bisa diaktifkan di Pengaturan.",
  },
  {
    title: "Stok otomatis",
    body: "Penjualan memotong stok, pembelian menambahnya. Koreksi stok (opname) tercatat; produk tanpa stok untuk jasa.",
  },
  {
    title: "Cetak struk & pricetag",
    body: "Printer thermal Bluetooth 58/80mm, struk PDF untuk dibagikan, dan pricetag thermal per produk atau PDF A4 grid 3×6 (18 label per halaman, ±48×40mm).",
  },
  {
    title: "Laporan usaha",
    body: "Penjualan, laba/rugi (estimasi), arus kas, barang terlaris, stok menipis, rekap kas — dan export Excel semua data.",
  },
  {
    title: "Data milik Anda",
    body: "100% offline, tersimpan di perangkat. Backup file .backup lokal (default) atau Google Drive (opsional). Open source GPL-3.0.",
  },
];

const faqs = [
  {
    q: "Apakah Intikasir butuh internet?",
    a: "Tidak. Operasional kasir 100% offline — jual, cetak struk, cek stok, dan lihat laporan bisa tanpa sinyal. Internet hanya dipakai untuk backup Google Drive (opsional) dan telemetri terbatas yang bisa dimatikan di Pengaturan.",
  },
  {
    q: "Berapa biayanya?",
    a: "Gratis. Tidak ada langganan, tidak ada iklan, dan tidak ada pembelian dalam aplikasi. Intikasir open source di bawah lisensi GPL-3.0 — kode sumbernya bisa Anda baca dan audit.",
  },
  {
    q: "Di mana data usaha saya disimpan?",
    a: "Di perangkat Anda sendiri. Tidak ada server Intikasir dan pengembang tidak bisa melihat data Anda. Backup hanya berjalan saat Anda menekan tombol backup, dan file backup disimpan di akun Google Anda (opsional) atau file lokal. Ingat: database dan file backup tidak dienkripsi — jaga perangkat dan akun Google Anda.",
  },
  {
    q: "Kapan rilis di Google Play?",
    a: `Intikasir sedang dalam tahap final menjelang rilis publik; fitur dan tampilan masih bisa berubah. Belum ada tanggal pasti yang bisa dijanjikan. Kalau Anda ingin diberi kabar rilisnya atau bertanya dulu, hubungi WhatsApp ${waNumber} — saya balas sebisanya.`,
  },
  {
    q: "Apakah laporan Intikasir bisa dipakai untuk pajak atau audit?",
    a: "Tidak. Laporan laba/rugi adalah estimasi sederhana (bukan akuntansi resmi) dan tidak ditujukan untuk audit atau pelaporan pajak. Untuk keperluan itu, konsultasikan dengan akuntan.",
  },
];
---

<BaseLayout
  title="Intikasir — Kasir offline untuk warung & UMKM"
  description="Aplikasi kasir Android untuk warung dan usaha kecil: penjualan, stok, uang masuk–keluar — 100% offline, tanpa langganan, gratis, open source GPL-3.0."
>
  <section class="flex flex-col gap-8 sm:flex-row sm:items-center">
    <div class="shrink-0">
      <div class="w-fit rounded-2xl bg-white p-3 ring-1 ring-border-subtle">
        <Image
          src={logo}
          alt="Logo Intikasir — huruf K hitam dengan titik merah"
          width={112}
          height={112}
          class="h-28 w-28"
          loading="eager"
        />
      </div>
    </div>
    <div>
      <p class="text-sm font-medium text-accent">Aplikasi Kasir Android · Segera hadir di Google Play</p>
      <h1
        class="mt-2 text-[clamp(2.1rem,5vw,3.25rem)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance"
      >
        {intikasirTagline}.
      </h1>
      <p class="mt-4 max-w-[58ch] text-[clamp(1.02rem,1.5vw,1.2rem)] leading-relaxed text-fg-muted">
        Catat penjualan, stok, dan uang masuk–keluar dari satu aplikasi. Tanpa langganan, tanpa
        akun tambahan, dan tetap jalan walau tanpa sinyal.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={waLink}
          rel="noopener"
          target="_blank"
          class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
        >
          Tanya kabar rilis via WhatsApp
        </a>
        <a
          href="#fitur"
          class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
        >
          Lihat fitur
        </a>
      </div>
      <p class="mt-4 text-xs text-fg-muted">Gratis · Tanpa iklan · Open source GPL-3.0</p>
    </div>
  </section>

  <section aria-labelledby="masalah" class="mt-16">
    <h2 id="masalah" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
      Masalah sehari-hari warung
    </h2>
    <p class="mt-3 text-[15px] leading-relaxed text-fg-muted">
      Mungkin ini yang Anda alami sekarang.
    </p>
    <ul class="mt-6 divide-y divide-border-subtle border-y border-border-subtle">
      {problems.map((p) => (
        <li class="grid gap-1 py-4 sm:grid-cols-2 sm:gap-6">
          <span class="text-[15px] text-fg-muted">{p.problem}</span>
          <span class="text-[15px] leading-relaxed">
            <span class="font-medium text-accent">→ </span>
            {p.solution}
          </span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="kenapa" class="mt-16">
    <h2 id="kenapa" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
      Kenapa gratis & aman?
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {[
        "Rp0 selamanya — tanpa langganan dan tanpa iklan",
        "100% offline — jual tetap jalan tanpa sinyal",
        "Data disimpan di perangkat Anda sendiri",
        "Open source GPL-3.0 — kode bisa dibaca dan diaudit",
      ].map((item) => (
        <li
          class="rounded-card border border-border-subtle bg-surface-raised px-5 py-4 text-[15px] leading-relaxed"
        >
          {item}
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="fitur-heading" id="fitur" class="mt-16 scroll-mt-24">
    <h2 id="fitur-heading" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
      Fitur utama
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {features.map((f) => (
        <li class="rounded-card border border-border-subtle bg-surface-raised p-5">
          <h3 class="text-lg font-semibold">{f.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{f.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="harga" class="mt-16">
    <div class="rounded-card border border-border-subtle bg-surface-raised p-6">
      <h2 id="harga" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
        Rp0. Selamanya.
      </h2>
      <p class="mt-3 max-w-[62ch] leading-relaxed text-fg-muted">
        Tanpa langganan, tanpa iklan, tanpa pembelian dalam aplikasi — dan open source
        (GPL-3.0). Tanpa akun dan tanpa cloud: data tidak pernah keluar dari perangkat
        tanpa tindakan Anda. Sebagai gantinya, jujur soal batasannya: laporan laba/rugi
        adalah estimasi (bukan akuntansi resmi), dan database maupun file backup tidak
        dienkripsi — detailnya ada di{" "}
        <a href="/intikasir/syarat-dan-ketentuan/" class="text-accent underline-offset-4 hover:underline">
          Syarat dan Ketentuan
        </a>.
      </p>
    </div>
  </section>

  <section aria-labelledby="faq" class="mt-16">
    <h2 id="faq" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
      Tanya jawab
    </h2>
    <div class="mt-6 divide-y divide-border-subtle border-y border-border-subtle">
      {faqs.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-[15px] font-medium leading-snug [&::-webkit-details-marker]:hidden">
            {item.q}
            <span
              aria-hidden="true"
              class="shrink-0 text-fg-muted transition-transform duration-200 group-open:rotate-45"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M7 1v12M1 7h12" />
              </svg>
            </span>
          </summary>
          <p class="mt-3 max-w-[65ch] text-[15px] leading-relaxed text-fg-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section aria-labelledby="rilis" class="mt-16">
    <h2 id="rilis" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
      Ingin jadi yang pertama tahu saat rilis?
    </h2>
    <p class="mt-3 max-w-[62ch] leading-relaxed text-fg-muted">
      Intikasir masih dalam tahap final menjelang rilis publik di Google Play — fitur dan
      tampilan dapat berubah. Hubungi WhatsApp atau email di bawah untuk tanya jawab dan
      kabar rilis.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={waLink}
        rel="noopener"
        target="_blank"
        class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
      >
        Chat WhatsApp
      </a>
      <a
        href={`mailto:${email}`}
        class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
      >
        {email}
      </a>
    </div>
    <p class="mt-6 text-sm text-fg-muted">
      Dokumen legal:{" "}
      <a href="/intikasir/syarat-dan-ketentuan/" class="text-accent underline-offset-4 hover:underline">Syarat dan Ketentuan</a>
      {" "}·{" "}
      <a href="/intikasir/kebijakan-privasi/" class="text-accent underline-offset-4 hover:underline">Kebijakan Privasi</a>
    </p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
</BaseLayout>
