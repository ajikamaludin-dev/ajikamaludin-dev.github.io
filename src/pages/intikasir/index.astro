---
import { Image } from "astro:assets";
import logo from "../../assets/intikasir/logo.png";
import stepKasir from "../../assets/intikasir/02-pos-kasir.jpg";
import stepQris from "../../assets/intikasir/03-pembayaran-qris.jpg";
import stepStruk from "../../assets/intikasir/04-struk-pdf.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile.ts";
import { intikasirDownloadUrl, intikasirTagline } from "../../data/products.ts";

const waNumber = profile.contacts.whatsapp;
const email = profile.contacts.email;

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Intikasir",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Android",
  inLanguage: "id",
  description:
    "Aplikasi kasir Android offline untuk warung dan UMKM: penjualan, stok, dan uang masuk–keluar di satu aplikasi. Gratis, tanpa langganan, open source GPL-3.0.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "IDR" },
  author: { "@type": "Person", name: profile.name, url: profile.site },
};

const cocokUntuk = [
  "Warung kelontong dan sembako",
  "Toko retail kecil",
  "Usaha makanan dan minuman",
  "Pedagang yang masih mencatat di kertas",
];

const langkah = [
  {
    title: "Pilih barang, tekan bayar",
    body: "Cari produk atau scan barcode dengan kamera HP. Kembalian dihitung otomatis dan stok langsung terpotong.",
    image: stepKasir,
    alt: "Layar kasir Intikasir di HP: Beras Premium, Gula Pasir, dan Minyak Goreng ada di keranjang dengan total Rp 116.000 dan tombol Bayar.",
  },
  {
    title: "Tunjukkan QRIS atau terima tunai",
    body: "Pembayaran tunai dan QRIS langsung tersedia. Cara bayar lain bisa dinyalakan kalau usaha Anda butuh.",
    image: stepQris,
    alt: "Layar pembayaran Intikasir dengan metode QRIS dipilih; kode QR statis tampil bersama tombol Perbesar QRIS untuk Pelanggan.",
  },
  {
    title: "Struk jadi, catatan rapi",
    body: "Bagikan struk PDF lewat WhatsApp atau cetak ke printer Bluetooth. Penjualan dan stok sudah tercatat dengan sendirinya.",
    image: stepStruk,
    alt: "Detail transaksi INV-20261118-0007 di Intikasir dengan tombol Bagikan PDF dan Cetak Struk.",
  },
];

const manfaat = [
  {
    title: "Jual lebih cepat",
    body: "Cari produk atau scan barcode, lalu kembalian dihitung sendiri. Tidak perlu menghitung di kepala saat antrean panjang.",
  },
  {
    title: "Bayar sesuai kebiasaan",
    body: "Tunai dan QRIS aktif dari awal. Transfer, EDC, e-wallet, dan kasbon bisa dinyalakan di Pengaturan.",
  },
  {
    title: "Stok terjaga",
    body: "Setiap jualan memotong stok, setiap pembelian menambahnya. Barang yang menipis lebih mudah terlihat.",
  },
  {
    title: "Struk tanpa ribet",
    body: "Struk PDF bisa dibagikan langsung dari HP, atau dicetak ke printer thermal Bluetooth. Label harga juga bisa dibuat.",
  },
  {
    title: "Untung kelihatan",
    body: "Lihat penjualan, uang masuk–keluar, dan estimasi laba kapan saja. Semua laporan bisa diekspor ke Excel.",
  },
  {
    title: "Data tetap di HP Anda",
    body: "Semua tersimpan di perangkat sendiri dan aplikasi jalan tanpa sinyal. Kode sumber terbuka (GPL-3.0) sehingga bisa diaudit.",
  },
];

const faqs = [
  {
    q: "Apakah Intikasir butuh internet?",
    a: "Tidak. Operasional kasir 100% offline — jual, cetak struk, cek stok, dan lihat laporan bisa tanpa sinyal. Internet hanya dipakai untuk backup Google Drive (opsional) dan telemetri terbatas yang bisa dimatikan di Pengaturan.",
  },
  {
    q: "Berapa biayanya?",
    a: "Gratis. Tidak ada langganan, iklan, atau pembelian dalam aplikasi. Intikasir open source di bawah lisensi GPL-3.0 — kode sumbernya bisa Anda baca dan audit.",
  },
  {
    q: "Di mana data usaha saya disimpan?",
    a: "Di perangkat Anda sendiri. Tidak ada server Intikasir dan pengembang tidak bisa melihat data Anda. Backup hanya berjalan saat Anda menekan tombol backup, dan file backup disimpan di akun Google Anda (opsional) atau file lokal. Ingat: database dan file backup tidak dienkripsi — jaga perangkat dan akun Google Anda.",
  },
  {
    q: "Kapan rilis di Google Play?",
    a: `Intikasir sedang dalam tahap final menjelang rilis publik; fitur dan tampilan masih bisa berubah dan belum ada tanggal pasti. Tombol "Download di Google Play" di halaman ini sementara menghubungkan Anda ke WhatsApp (${waNumber}) untuk minta link dan kabar rilis.`,
  },
  {
    q: "Apakah laporan Intikasir bisa dipakai untuk pajak atau audit?",
    a: "Tidak. Laporan laba/rugi adalah estimasi sederhana (bukan akuntansi resmi) dan tidak ditujukan untuk audit atau pelaporan pajak. Untuk keperluan itu, konsultasikan dengan akuntan.",
  },
  {
    q: "Bisa dipakai karyawan atau kasir lain?",
    a: "Belum. Versi pertama Intikasir dipakai oleh satu pemilik sekaligus kasir — belum ada akun atau hak akses terpisah untuk karyawan.",
  },
  {
    q: "Bisa buat struk tanpa printer?",
    a: "Bisa. Struk bisa disimpan atau dibagikan sebagai PDF lewat WhatsApp, jadi printer thermal tidak wajib. Kalau Anda punya printer Bluetooth 58/80 mm, struk juga bisa dicetak langsung.",
  },
];
---

<BaseLayout
  title="Intikasir — Kasir offline untuk warung & UMKM"
  description="Aplikasi kasir Android untuk warung dan usaha kecil: penjualan, stok, uang masuk–keluar — 100% offline, tanpa langganan, gratis, open source GPL-3.0."
>
  <div class="inti-page @container">
    <section class="flex flex-col gap-8 @md:flex-row @md:items-center">
      <div class="shrink-0">
        <div class="w-fit rounded-2xl bg-white p-3 ring-1 ring-border-subtle">
          <Image
            src={logo}
            alt="Logo Intikasir — huruf K hitam dengan titik merah"
            width={112}
            height={112}
            class="h-28 w-28"
            loading="eager"
          />
        </div>
      </div>
      <div>
        <p class="flex items-center gap-2 text-sm font-medium text-fg">
          <span aria-hidden="true" class="h-2 w-2 shrink-0 rounded-full bg-inti-red"></span>
          Aplikasi kasir Android · Segera di Google Play
        </p>
        <h1
          class="mt-2 text-[clamp(2.1rem,5vw,3.25rem)] font-semibold leading-[1.08] tracking-[-0.02em] text-balance"
        >
          Kasir warung yang jalan tanpa sinyal
        </h1>
        <p class="mt-3 text-[clamp(1.1rem,1.7vw,1.3rem)] font-medium text-accent">
          {intikasirTagline}.
        </p>
        <p class="mt-4 max-w-[58ch] text-[clamp(1.02rem,1.5vw,1.2rem)] leading-relaxed text-fg-muted">
          Catat penjualan, stok, dan uang masuk–keluar dari satu aplikasi. Tanpa langganan, tanpa
          akun tambahan, dan tetap jalan walau tanpa sinyal.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={intikasirDownloadUrl}
            rel="noopener"
            target="_blank"
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Download di Google Play
          </a>
          <a
            href="#cara-kerja"
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Lihat cara kerjanya
          </a>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-fg-muted">
          Segera rilis — tombol ini menghubungkan Anda ke WhatsApp untuk minta link &amp; kabar.
        </p>
        <p class="mt-2 text-xs text-fg-muted">Gratis · Tanpa iklan · Open source GPL-3.0</p>
      </div>
    </section>

    <section aria-labelledby="cocok" class="mt-16">
      <h2 id="cocok" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
        Cocok untuk siapa?
      </h2>
      <p class="mt-3 text-[15px] leading-relaxed text-fg-muted">
        Kalau ini kebiasaan di usaha Anda, Intikasir dibuat untuk Anda.
      </p>
      <ul class="mt-6 grid gap-3 @sm:grid-cols-2">
        {cocokUntuk.map((item) => (
          <li class="flex items-start gap-3 rounded-card border border-border-subtle bg-surface-raised px-5 py-4 text-[15px] leading-relaxed">
            <span aria-hidden="true" class="shrink-0 font-semibold text-accent">✓</span>
            {item}
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="cara-kerja-heading" id="cara-kerja" class="mt-16 scroll-mt-24">
      <h2 id="cara-kerja-heading" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
        Tiga langkah, selesai
      </h2>
      <p class="mt-3 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted">
        Tidak perlu pelatihan. Ini alur yang paling sering dipakai setiap hari di warung.
      </p>
      <ol class="mt-6 grid gap-6 @md:grid-cols-3">
        {langkah.map((step, index) => (
          <li>
            <div class="overflow-hidden rounded-card border border-border-subtle bg-surface-raised">
              <Image
                src={step.image}
                alt={step.alt}
                width={288}
                height={640}
                class="mx-auto h-auto w-full max-w-[220px] rounded-t-card @md:max-w-none"
                loading="lazy"
              />
            </div>
            <h3 class="mt-4 flex items-center gap-2 text-lg font-semibold">
              <span
                aria-hidden="true"
                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-semibold text-surface"
              >
                {index + 1}
              </span>
              {step.title}
            </h3>
            <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{step.body}</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-xs text-fg-muted">
        Tampilan dari build beta; data di layar adalah contoh, bukan data pelanggan.
      </p>
    </section>

    <section aria-labelledby="manfaat" class="mt-16">
      <h2 id="manfaat" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
        Yang Anda dapatkan
      </h2>
      <ul class="mt-6 grid gap-4 @sm:grid-cols-2">
        {manfaat.map((item) => (
          <li class="rounded-card border border-border-subtle bg-surface-raised p-5">
            <h3 class="text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-fg-muted">{item.body}</p>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="harga" class="mt-16">
      <div class="rounded-card border border-border-subtle bg-surface-raised p-6">
        <h2 id="harga" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
          Rp0. Selamanya.
        </h2>
        <p class="mt-3 max-w-[62ch] leading-relaxed text-fg-muted">
          Tanpa langganan, iklan, akun, atau cloud. Data tidak pernah keluar dari perangkat tanpa
          tindakan Anda.
        </p>
        <p class="mt-3 text-sm leading-relaxed text-fg-muted">
          Jujur soal batasannya: laporan laba/rugi hanya estimasi, dan database serta file backup
          belum dienkripsi. Detailnya di{" "}
          <a
            href="/intikasir/syarat-dan-ketentuan/"
            class="text-accent underline-offset-4 hover:underline"
          >
            Syarat dan Ketentuan
          </a>.
        </p>
      </div>
    </section>

    <section aria-labelledby="faq" class="mt-16">
      <h2 id="faq" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
        Tanya jawab
      </h2>
      <div class="mt-6 divide-y divide-border-subtle border-y border-border-subtle">
        {faqs.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-[15px] font-medium leading-snug [&::-webkit-details-marker]:hidden">
              {item.q}
              <span
                aria-hidden="true"
                class="shrink-0 text-fg-muted transition-transform duration-200 group-open:rotate-45"
              >
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <path d="M7 1v12M1 7h12" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-[65ch] text-[15px] leading-relaxed text-fg-muted">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section aria-labelledby="rilis" class="mt-16">
      <h2 id="rilis" class="text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]">
        Mulai pakai begitu rilis
      </h2>
      <p class="mt-3 max-w-[62ch] leading-relaxed text-fg-muted">
        Intikasir masih final menjelang rilis publik di Google Play — fitur dan tampilan masih bisa
        berubah. Klik tombol di bawah untuk minta link lewat WhatsApp, atau tanya lewat email.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={intikasirDownloadUrl}
          rel="noopener"
          target="_blank"
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Download di Google Play
        </a>
        <a
          href={`mailto:${email}`}
          class="inline-flex min-h-11 items-center justify-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {email}
        </a>
      </div>
      <p class="mt-3 text-xs leading-relaxed text-fg-muted">
        Segera rilis — tombol ini menghubungkan Anda ke WhatsApp untuk minta link &amp; kabar.
      </p>
      <p class="mt-6 text-sm text-fg-muted">
        Dokumen legal:{" "}
        <a href="/intikasir/syarat-dan-ketentuan/" class="text-accent underline-offset-4 hover:underline">Syarat dan Ketentuan</a>
        {" "}·{" "}
        <a href="/intikasir/kebijakan-privasi/" class="text-accent underline-offset-4 hover:underline">Kebijakan Privasi</a>
      </p>
    </section>

    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
  </div>
</BaseLayout>
