---
import { getCollection } from "astro:content";
import TutorialSearch from "../../../components/islands/TutorialSearch.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const rawTutorials = await getCollection("dotkasirTutorials");

// Urutkan berdasarkan kategori lalu order
const tutorials = rawTutorials
  .map((t) => ({
    id: t.id,
    title: t.data.title,
    description: t.data.description,
    category: t.data.category,
    categoryName: t.data.categoryName,
    tags: t.data.tags,
    order: t.data.order,
  }))
  .sort((a, b) => a.order - b.order);

// Kategori unik untuk filter chips
const categoryMap = new Map<string, string>();
for (const t of rawTutorials) {
  if (!categoryMap.has(t.data.category)) {
    categoryMap.set(t.data.category, t.data.categoryName);
  }
}

const categories = Array.from(categoryMap.entries()).map(([key, name]) => ({
  key,
  name,
}));

const title = "Panduan & Tutorial dotKasir — Dokumentasi Lengkap Aplikasi Kasir";
const description =
  "Panduan lengkap langkah demi langkah menggunakan aplikasi dotKasir: dari kelola kategori, produk, transaksi kasir, struk thermal, laporan, hingga backup data.";
---

<BaseLayout title={title} description={description}>
  <div class="dot-page @container max-w-4xl mx-auto">
    <!-- Breadcrumb Navigasi -->
    <nav aria-label="Breadcrumb" class="text-xs text-fg-muted">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li>
          <a href="/" class="hover:text-accent transition-colors">Beranda</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/dotkasir/" class="hover:text-accent transition-colors">Dotkasir</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-fg">Tutorial</li>
      </ol>
    </nav>

    <!-- Header Halaman -->
    <header class="mt-6">
      <p class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide uppercase text-accent">
        <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-accent"></span>
        Dokumentasi & Basis Pengetahuan
      </p>
      <h1 class="mt-2 text-[clamp(1.8rem,4vw,2.75rem)] font-bold tracking-[-0.02em] leading-tight text-fg text-balance">
        Panduan & Tutorial Aplikasi dotKasir
      </h1>
      <p class="mt-3 text-[clamp(1rem,1.4vw,1.15rem)] leading-relaxed text-fg-muted max-w-[65ch]">
        Temukan panduan lengkap untuk setiap aksi dan fitur di aplikasi kasir dotKasir. Setiap langkah dilengkapi gambar penjelas beranotasi langsung dari aplikasi.
      </p>
    </header>

    <!-- Area Pencarian & Daftar Kartu -->
    <main id="main-content" class="mt-8">
      <TutorialSearch tutorials={tutorials} categories={categories} />
    </main>

    <!-- Footer Panduan -->
    <section class="mt-16 rounded-card border border-border-subtle bg-surface-raised p-6 text-sm">
      <h2 class="text-base font-semibold text-fg">Butuh bantuan langsung?</h2>
      <p class="mt-1 text-fg-muted leading-relaxed">
        Jika Anda mengalami kendala teknis atau memiliki pertanyaan yang belum tercakup dalam panduan ini, hubungi pengembang langsung via WhatsApp di
        <a href="https://wa.me/6281325307692" target="_blank" rel="noopener" class="text-accent underline underline-offset-2">
          0813-2530-7692
        </a>.
      </p>
    </section>
  </div>
</BaseLayout>
