---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const tutorials = await getCollection("dotkasirTutorials");
  return tutorials.map((tutorial) => ({
    params: { slug: tutorial.id },
    props: { tutorial },
  }));
}

const { tutorial } = Astro.props;
const { Content } = await render(tutorial);

// Ambil seluruh tutorial dalam kategori yang sama untuk navigasi sebelum/sesudah
const allTutorials = await getCollection("dotkasirTutorials");
const categoryTutorials = allTutorials
  .filter((t) => t.data.category === tutorial.data.category)
  .sort((a, b) => a.data.order - b.data.order);

const currentIndex = categoryTutorials.findIndex((t) => t.id === tutorial.id);
const prevTutorial = currentIndex > 0 ? categoryTutorials[currentIndex - 1] : null;
const nextTutorial =
  currentIndex >= 0 && currentIndex < categoryTutorials.length - 1
    ? categoryTutorials[currentIndex + 1]
    : null;

const pageTitle = `${tutorial.data.title} — Panduan dotKasir`;
const pageDesc = tutorial.data.description;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <div class="dot-page @container max-w-3xl mx-auto">
    <!-- Breadcrumb Navigasi -->
    <nav aria-label="Breadcrumb" class="text-xs text-fg-muted">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li>
          <a href="/" class="hover:text-accent transition-colors">Beranda</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/dotkasir/" class="hover:text-accent transition-colors">Dotkasir</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/dotkasir/tutorial/" class="hover:text-accent transition-colors">Tutorial</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-fg truncate max-w-[28ch]">
          {tutorial.data.title}
        </li>
      </ol>
    </nav>

    <!-- Header Artikel -->
    <header class="mt-6 border-b border-border-subtle pb-6">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded-md bg-accent/10 px-2.5 py-0.5 text-xs font-semibold text-accent">
          {tutorial.data.categoryName}
        </span>
        <span class="text-xs text-fg-muted">
          Langkah #{tutorial.data.order}
        </span>
      </div>

      <h1 class="mt-3 text-[clamp(1.75rem,3.8vw,2.5rem)] font-bold tracking-[-0.02em] leading-tight text-fg text-balance">
        {tutorial.data.title}
      </h1>

      <p class="mt-3 text-[clamp(1rem,1.3vw,1.1rem)] leading-relaxed text-fg-muted">
        {tutorial.data.description}
      </p>

      {tutorial.data.tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tutorial.data.tags.map((tag: string) => (
            <span class="rounded bg-surface-raised px-2 py-0.5 text-xs text-fg-muted border border-border-subtle">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Konten Utama Markdown -->
    <article class="prose prose-neutral dark:prose-invert mt-8 max-w-none text-fg leading-relaxed
      [&_h2]:text-[clamp(1.3rem,2.5vw,1.6rem)] [&_h2]:font-bold [&_h2]:tracking-[-0.01em] [&_h2]:mt-8 [&_h2]:mb-3 [&_h2]:text-fg
      [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-fg
      [&_p]:text-[15px] [&_p]:leading-relaxed [&_p]:text-fg [&_p]:my-4
      [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:my-4 [&_ol>li]:my-2 [&_ol>li]:text-[15px]
      [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:my-4 [&_ul>li]:my-1.5 [&_ul>li]:text-[15px]
      [&_strong]:font-semibold [&_strong]:text-fg
      [&_blockquote]:border-l-4 [&_blockquote]:border-accent [&_blockquote]:bg-surface-raised [&_blockquote]:p-4 [&_blockquote]:rounded-r-lg [&_blockquote]:my-5
      [&_img]:mx-auto [&_img]:my-6 [&_img]:w-[75%] [&_img]:max-w-[540px] [&_img]:h-auto [&_img]:rounded-xl [&_img]:border [&_img]:border-border-control [&_img]:shadow-sm
    ">
      <Content />
    </article>

    <!-- Navigasi Panduan Terkait (Sebelum & Sesudah) -->
    <div class="mt-12 border-t border-border-subtle pt-6">
      <div class="flex flex-col sm:flex-row items-stretch justify-between gap-4">
        {prevTutorial ? (
          <a
            href={`/dotkasir/tutorial/${prevTutorial.id}/`}
            class="flex-1 rounded-card border border-border-subtle bg-surface-raised p-4 transition-colors duration-150 hover:border-accent"
          >
            <span class="block text-xs text-fg-muted">&larr; Panduan Sebelumnya</span>
            <span class="mt-1 block text-sm font-semibold text-fg">
              {prevTutorial.data.title}
            </span>
          </a>
        ) : (
          <div class="flex-1"></div>
        )}

        {nextTutorial ? (
          <a
            href={`/dotkasir/tutorial/${nextTutorial.id}/`}
            class="flex-1 rounded-card border border-border-subtle bg-surface-raised p-4 text-right transition-colors duration-150 hover:border-accent"
          >
            <span class="block text-xs text-fg-muted">Panduan Selanjutnya &rarr;</span>
            <span class="mt-1 block text-sm font-semibold text-fg">
              {nextTutorial.data.title}
            </span>
          </a>
        ) : (
          <div class="flex-1"></div>
        )}
      </div>

      <div class="mt-6 text-center">
        <a
          href="/dotkasir/tutorial/"
          class="inline-flex items-center text-sm font-medium text-accent hover:underline"
        >
          &larr; Kembali ke Daftar Semua Tutorial
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
