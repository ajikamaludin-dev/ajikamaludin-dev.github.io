---
import { getCollection } from "astro:content";
import SearchBox from "../../components/islands/SearchBox.astro";
import { profile } from "../../data/profile.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat("id-ID", { day: "numeric", month: "long", year: "numeric" }).format(d);
---

<BaseLayout
  title={`Blog Teknis ${profile.name} — PHP, Go, Linux`}
  description="Catatan teknis Aji Kamaludin seputar PHP, Laravel, Go, Linux, Nginx, dan virtualisasi — ditulis dari pengalaman menangani sistem produksi."
>
  <header class="max-w-[65ch]">
    <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em]">
      Blog
    </h1>
    <p class="mt-5 text-[clamp(1rem,1.5vw,1.125rem)] leading-relaxed text-fg-muted">
      Catatan teknis seputar PHP, Go, Linux, jaringan, dan operasi server.
    </p>
  </header>

  <div class="mt-10 max-w-[42ch]">
    <SearchBox />
  </div>

  {
    posts.length === 0 ? (
      <p class="mt-14 border-t border-border-subtle pt-6 text-fg-muted">
        Belum ada artikel yang dipublikasikan.
      </p>
    ) : (
      <ol class="mt-14 space-y-10">
        {posts.map((post) => (
          <li class="border-t border-border-subtle pt-6">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 text-sm text-fg-muted">
              <time datetime={post.data.pubDate.toISOString()} class="font-mono tabular-nums">
                {fmt(post.data.pubDate)}
              </time>
              {post.data.tags.length > 0 && (
                <span class="flex flex-wrap gap-x-3 gap-y-1">
                  {post.data.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </span>
              )}
            </div>

            <h2 class="mt-2 text-[clamp(1.2rem,2.4vw,1.5rem)] font-semibold leading-snug tracking-tight">
              <a
                href={`/blog/${post.id}/`}
                class="underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
              >
                {post.data.title}
              </a>
            </h2>

            <p class="mt-2 max-w-[65ch] text-[15px] leading-relaxed text-fg-muted">
              {post.data.description}
            </p>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>
