---
import { achievements, certifications } from "../data/certifications.ts";
import { education, experience } from "../data/experience.ts";
import { otherLinks } from "../data/products.ts";
import { profile } from "../data/profile.ts";
import { skills } from "../data/skills.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatRange } from "../utils/date.ts";

const issuers = [...new Set(certifications.map((c) => c.issuer))];

const sections = [
  { id: "pengalaman", label: "Pengalaman" },
  { id: "pendidikan", label: "Pendidikan" },
  { id: "keahlian", label: "Keahlian" },
  { id: "sertifikasi", label: "Sertifikasi" },
  { id: "pencapaian", label: "Pencapaian" },
  { id: "tautan", label: "Tautan Lain" },
];
---

<BaseLayout
  title={`Tentang ${profile.name} — ${profile.role}`}
  description="Riwayat kerja, pendidikan, sertifikasi, dan keahlian Aji Kamaludin — Software Engineer di Klaten, Indonesia."
>
  <header class="max-w-[65ch]">
    <h1 class="text-[clamp(2rem,5vw,3.25rem)] font-semibold leading-[1.05] tracking-[-0.02em]">
      Tentang saya
    </h1>
    <p class="mt-5 text-[clamp(1rem,1.5vw,1.125rem)] leading-relaxed text-fg-muted">
      {profile.summary}
    </p>
    <p class="mt-4 text-[15px] leading-relaxed text-fg-muted">
      Sekarang di {profile.location}. Bisa dihubungi lewat{" "}
      <a
        href={`mailto:${profile.contacts.email}`}
        class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
      >
        email
      </a>{" "}
      atau{" "}
      <a
        href={`https://wa.me/${profile.contacts.whatsapp.replace(/[^0-9]/g, '')}`}
        rel="noopener"
        class="text-fg underline decoration-border-control underline-offset-4 transition-colors duration-150 hover:text-accent"
      >
        WhatsApp
      </a>.
    </p>
  </header>

  <nav aria-label="Daftar isi" class="mt-10 border-t border-border-subtle pt-5">
    <ul class="flex flex-wrap gap-x-5 gap-y-2">
      {
        sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="inline-flex min-h-11 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <section id="pengalaman" class="mt-16 scroll-mt-24" aria-labelledby="h-pengalaman">
    <h2
      id="h-pengalaman"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Pengalaman
    </h2>

    <ol class="mt-8 space-y-10">
      {
        experience.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <div>
              <p class="font-mono text-[13px] leading-6 text-fg-muted tabular-nums">
                {formatRange(job.start, job.end)}
              </p>
              <p class="text-[13px] leading-6 text-fg-muted">
                {job.mode}
                {job.partTime ? ' · paruh waktu' : ''}
              </p>
            </div>
            <div>
              <h3 class="text-[15px] font-medium leading-6">
                {job.role}
                <span class="text-fg-muted"> · {job.company}</span>
              </h3>
              <p class="mt-1 text-[13px] text-fg-muted">{job.location}</p>
              <p class="mt-2 max-w-[62ch] text-[15px] leading-relaxed">{job.summary}</p>
              <ul class="mt-3 max-w-[62ch] space-y-1.5">
                {job.highlights.map((h) => (
                  <li class="relative pl-4 text-[15px] leading-relaxed text-fg-muted">
                    <span
                      aria-hidden="true"
                      class="absolute left-0 top-[0.6em] h-1 w-1 rounded-full bg-accent"
                    />
                    {h}
                  </li>
                ))}
              </ul>
              {job.stack.length > 0 && (
                <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[12px] text-fg-muted">
                  {job.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="pendidikan" class="mt-16 scroll-mt-24" aria-labelledby="h-pendidikan">
    <h2
      id="h-pendidikan"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Pendidikan
    </h2>
    <ol class="mt-8 space-y-6">
      {
        education.map((e) => (
          <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="font-mono text-[13px] leading-6 text-fg-muted tabular-nums">
              {formatRange(e.start, e.end)}
            </p>
            <div>
              <p class="text-[15px] font-medium leading-6">{e.institution}</p>
              <p class="mt-1 text-[15px] leading-relaxed text-fg-muted">{e.degree}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="keahlian" class="mt-16 scroll-mt-24" aria-labelledby="h-keahlian">
    <h2
      id="h-keahlian"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Keahlian
    </h2>
    <dl class="mt-8 space-y-6">
      {
        skills.map((group) => (
          <div class="grid gap-1.5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="text-[15px] font-medium leading-6">{group.category}</dt>
            <dd class="flex flex-wrap gap-x-4 gap-y-1.5 text-[15px] leading-relaxed text-fg-muted">
              {group.items.map((item) => (
                <span>{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="sertifikasi" class="mt-16 scroll-mt-24" aria-labelledby="h-sertifikasi">
    <h2
      id="h-sertifikasi"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Sertifikasi
      <span class="ml-2 align-middle font-mono text-[13px] font-normal text-fg-muted">
        {certifications.length}
      </span>
    </h2>
    <div class="mt-8 space-y-7">
      {
        issuers.map((issuer) => (
          <div class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="text-[15px] font-medium leading-6">{issuer}</p>
            <ul class="space-y-1.5">
              {certifications
                .filter((c) => c.issuer === issuer)
                .map((c) => (
                  <li class="flex items-baseline justify-between gap-4 text-[15px] leading-relaxed">
                    <span class="text-fg-muted">{c.name}</span>
                    <span class="shrink-0 font-mono text-[13px] tabular-nums text-fg-muted">
                      {c.year}
                    </span>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section id="pencapaian" class="mt-16 scroll-mt-24" aria-labelledby="h-pencapaian">
    <h2
      id="h-pencapaian"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Pencapaian
    </h2>
    <ul class="mt-8 space-y-5">
      {
        achievements.map((a) => (
          <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="font-mono text-[13px] leading-6 text-fg-muted tabular-nums">{a.year}</p>
            <p class="text-[15px] leading-relaxed">
              <span class="font-medium">{a.title}</span>
              <span class="text-fg-muted"> — {a.detail}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="tautan" class="mt-16 scroll-mt-24" aria-labelledby="h-tautan">
    <h2
      id="h-tautan"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Tautan lain
    </h2>
    <ul class="mt-6 flex flex-wrap gap-3">
      {
        otherLinks.map((link) => (
          <li>
            <a
              href={link.url}
              rel="noopener"
              target="_blank"
              class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
