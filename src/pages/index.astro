---
import { experience } from "../data/experience.ts";
import { navLinks, profile } from "../data/profile.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatRange } from "../utils/date.ts";

const recent = experience.slice(0, 3);
const summaryHref = navLinks.find((l) => l.label === "Projects")?.href ?? "/projects/";
---

<BaseLayout
  title="Aji Kamaludin — Software Engineer (PHP, Go, AWS, Linux)"
  description="Portfolio Aji Kamaludin, software engineer di Klaten dengan pengalaman 6+ tahun di PHP, Laravel, Go, React, dan AWS. Riwayat kerja, blog teknis, dan produk."
>
  <section class="relative isolate overflow-hidden rounded-3xl">
    <div class="hero-gradient absolute inset-0" aria-hidden="true"></div>

    <div
      class="hero-glass relative grid gap-8 p-6 sm:grid-cols-[1fr_auto] sm:items-start sm:gap-12 sm:p-10"
    >
      <div>
        <!-- Satu-satunya elemen berani di halaman ini. -->
        <h1
          class="text-[clamp(2.75rem,9vw,5rem)] font-semibold leading-[0.95] tracking-[-0.03em] text-balance"
        >
          {profile.name}
        </h1>

        <p class="mt-5 text-[clamp(1.05rem,2vw,1.3rem)] leading-snug text-fg-muted">
          {profile.role} in {profile.location}.
        </p>

        <p class="mt-5 max-w-[52ch] text-[clamp(1rem,1.5vw,1.125rem)] leading-relaxed">
          {profile.heroTagline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={summaryHref}
            class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
          >
            Lihat proyek
          </a>
          <a
            href="/about/"
            class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
          >
            Profil lengkap
          </a>
        </div>
      </div>

      <img
        src={profile.avatar}
        alt="Avatar Aji Kamaludin"
        width="160"
        height="160"
        loading="eager"
        fetchpriority="high"
        class="h-32 w-32 shrink-0 rounded-full object-cover ring-1 ring-border-control sm:h-40 sm:w-40"
      />
    </div>
  </section>

  <section class="mt-20" aria-labelledby="pengalaman">
    <div class="flex items-baseline justify-between gap-4 border-t border-border-subtle pt-6">
      <h2 id="pengalaman" class="text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight">
        Pengalaman
      </h2>
      <a
        href="/about/#pengalaman"
        class="inline-flex min-h-11 shrink-0 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
      >
        Semua
      </a>
    </div>

    <ol class="mt-8 space-y-8">
      {
        recent.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="font-mono text-[13px] leading-6 text-fg-muted tabular-nums">
              {formatRange(job.start, job.end)}
            </p>
            <div>
              <p class="text-[15px] font-medium leading-6">
                {job.role}
                <span class="text-fg-muted"> · {job.company}</span>
              </p>
              <p class="mt-1 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted">
                {job.highlights[0]}
              </p>
              {job.stack.length > 0 && (
                <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[12px] text-fg-muted">
                  {job.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
