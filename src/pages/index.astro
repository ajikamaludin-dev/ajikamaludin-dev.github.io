---
import { getCollection } from "astro:content";
import {
  consultingCopy,
  engagementModel,
  processSteps,
  proofMetrics,
  services,
} from "../data/consulting.ts";
import { experience } from "../data/experience.ts";
import { intikasirDownloadUrl, products } from "../data/products.ts";
import { profile, whatsappUrl } from "../data/profile.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPublishedDate, formatRange } from "../utils/date.ts";

const recent = experience.slice(0, 3);
const intikasir = products.find((p) => p.slug === "intikasir");
const consultationUrl = whatsappUrl(consultingCopy.consultationMessage);

const latestPost = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)[0];
---

<BaseLayout
  title="Konsultan MVP & Pengembang Aplikasi untuk UMKM & Startup — Aji Kamaludin"
  description="Konsultan MVP dan pengembang aplikasi untuk UMKM besar & startup — dari discovery dan arsitektur sampai rilis. 6+ tahun membangun sistem untuk bisnis."
>
  <section class="relative isolate overflow-hidden rounded-3xl">
    <div class="hero-gradient absolute inset-0" aria-hidden="true"></div>

    <div
      class="hero-glass relative grid gap-8 p-6 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-12 sm:p-10"
    >
      <div class="min-w-0">
        <p class="font-mono text-[11px] uppercase tracking-wider text-accent">
          {consultingCopy.eyebrow}
        </p>

        <h1
          class="mt-4 text-[clamp(2.25rem,7.5vw,4.25rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-balance"
        >
          {consultingCopy.headline}
        </h1>

        <p class="mt-5 max-w-[56ch] text-[clamp(1rem,1.6vw,1.15rem)] leading-relaxed text-fg-muted">
          {consultingCopy.subheadline}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={consultationUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
          >
            {consultingCopy.ctaPrimary}
          </a>
          <a
            href="#layanan"
            class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
          >
            {consultingCopy.ctaSecondary}
          </a>
        </div>
      </div>

      <img
        src={profile.avatar}
        alt="Foto profil Aji Kamaludin, konsultan MVP dan pengembang aplikasi"
        width="160"
        height="160"
        loading="eager"
        fetchpriority="high"
        class="h-28 w-28 shrink-0 rounded-full object-cover ring-1 ring-border-control sm:h-40 sm:w-40"
      />
    </div>
  </section>

  <section class="mt-12 @container" aria-labelledby="bukti">
    <h2 id="bukti" class="font-mono text-[11px] uppercase tracking-wider text-fg-muted">
      Bukti yang bisa diverifikasi
    </h2>
    <dl class="mt-4 grid grid-cols-2 gap-4 @md:grid-cols-4">
      {
        proofMetrics.map((m) => (
          <div class="rounded-3xl border border-border-subtle bg-surface-raised p-5 sm:p-6">
            <dt class="sr-only">{m.label}</dt>
            <dd>
              <p class="font-mono text-[clamp(1.75rem,4vw,2.5rem)] font-semibold leading-none tracking-tight text-accent tabular-nums">
                {m.value}
              </p>
              <p class="mt-3 text-[13px] leading-snug text-fg-muted">{m.label}</p>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="layanan" class="mt-20 scroll-mt-24 @container" aria-labelledby="h-layanan">
    <h2
      id="h-layanan"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Layanan
    </h2>
    <div class="mt-8 grid grid-cols-1 gap-4 @md:grid-cols-2">
      {
        services.map((s, i) => (
          <article class="rounded-3xl border border-border-subtle bg-surface-raised p-6">
            <p class="font-mono text-[12px] text-accent">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 text-[clamp(1.05rem,2vw,1.25rem)] font-semibold tracking-tight">
              {s.title}
            </h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-relaxed text-fg-muted">
              {s.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="proses" class="mt-20 scroll-mt-24 @container" aria-labelledby="h-proses">
    <h2
      id="h-proses"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Cara kerja
    </h2>
    <ol class="mt-8 grid grid-cols-1 gap-6 @md:grid-cols-2">
      {
        processSteps.map((step, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4">
            <span class="font-mono text-[13px] font-medium text-accent tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="text-[15px] font-medium leading-6">{step.title}</h3>
              <p class="mt-1 max-w-[52ch] text-[15px] leading-relaxed text-fg-muted">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    intikasir && (
      <section class="mt-20 @container" aria-labelledby="rilis-intikasir">
        <div class="rounded-3xl border border-border-subtle bg-surface-raised p-6 sm:p-8">
          <div class="flex flex-col gap-6 @md:flex-row @md:items-center @md:justify-between">
            <div class="min-w-0">
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-accent">
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                  Sudah rilis
                </span>
                <span class="font-mono text-[11px] uppercase tracking-wider text-fg-muted">
                  Case study · Dibangun dari nol
                </span>
              </p>
              <h2
                id="rilis-intikasir"
                class="mt-3 text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]"
              >
                {intikasir.name}
              </h2>
              <p class="mt-1 text-[clamp(1.05rem,1.7vw,1.25rem)] font-medium text-accent">
                {intikasir.tagline}
              </p>
              <p class="mt-3 max-w-[58ch] text-[15px] leading-relaxed text-fg-muted">
                Aplikasi kasir Android offline — dari riset kebutuhan, desain, pengembangan, sampai
                rilis di Google Play. Membuktikan kemampuan membangun produk end-to-end untuk bisnis.
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-3">
              <a
                href={intikasirDownloadUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
              >
                Download di Google Play
              </a>
              <a
                href="/intikasir/"
                class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
              >
                Kenali Intikasir
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="mt-20" aria-labelledby="pengalaman">
    <div class="flex items-baseline justify-between gap-4 border-t border-border-subtle pt-6">
      <h2 id="pengalaman" class="text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight">
        Pengalaman & klien
      </h2>
      <a
        href="/about/#pengalaman"
        class="inline-flex min-h-11 shrink-0 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
      >
        Semua
      </a>
    </div>

    <ol class="mt-8 space-y-8">
      {
        recent.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="font-mono text-[13px] leading-6 text-fg-muted tabular-nums">
              {formatRange(job.start, job.end)}
            </p>
            <div>
              <p class="text-[15px] font-medium leading-6">
                {job.role}
                <span class="text-fg-muted"> · {job.company}</span>
              </p>
              <p class="mt-1 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted">
                {job.highlights[0]}
              </p>
              {job.stack.length > 0 && (
                <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[12px] text-fg-muted">
                  {job.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    latestPost && (
      <section class="mt-20" aria-labelledby="konten-terbaru">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wider text-fg-muted">
            Konten terbaru
          </p>

          <div class="mt-2 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h2 id="konten-terbaru" class="min-w-0 text-[0.95rem] font-medium leading-snug">
              <a
                href={`/blog/${latestPost.id}/`}
                class="text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
              >
                {latestPost.data.title}
              </a>
            </h2>

            <p class="shrink-0 font-mono text-[11px] tabular-nums text-fg-muted">
              <time datetime={latestPost.data.pubDate.toISOString()}>
                {formatPublishedDate(latestPost.data.pubDate)}
                {latestPost.data.pubTime ? ` · ${latestPost.data.pubTime} WIB` : ""}
              </time>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="mt-20" aria-labelledby="h-cta">
    <div class="rounded-3xl border border-border-subtle bg-surface-raised p-6 sm:p-10">
      <h2
        id="h-cta"
        class="text-[clamp(1.5rem,3.5vw,2.25rem)] font-semibold tracking-tight text-balance"
      >
        Ada ide aplikasi? Mari diskusi.
      </h2>
      <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-fg-muted">
        Konsultasi awal gratis — ceritakan masalah bisnis Anda, lalu kita lihat apa yang bisa
        dibangun bersama. Model kerja: {engagementModel}
      </p>
      <a
        href={consultationUrl}
        target="_blank"
        rel="noopener"
        class="mt-7 inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
      >
        {consultingCopy.ctaPrimary}
      </a>
    </div>
  </section>
</BaseLayout>
