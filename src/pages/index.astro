---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { consultingCopy, engagementModel, processSteps, services } from "../data/consulting.ts";
import { experience } from "../data/experience.ts";
import { dotkasirDownloadUrl, products } from "../data/products.ts";
import { profile, whatsappUrl } from "../data/profile.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPublishedDate, formatRange } from "../utils/date.ts";

const recent = experience.slice(0, 3);
const dotkasir = products.find((p) => p.slug === "dotkasir");
const consultationUrl = whatsappUrl(consultingCopy.consultationMessage);

const latestPost = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)[0];

const excludedFromKarya = new Set([
  "nusatravel",
  "approval-po",
  "web-event",
  "dti-event",
  "hootka",
  "florist-order",
  "crm-klinik",
]);

const allProjects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const karyaProjects = allProjects.filter((p) => !excludedFromKarya.has(p.id));
---

<BaseLayout
  title="Konsultan MVP & Pengembang Aplikasi untuk UMKM & Startup — Aji Kamaludin"
  description="Konsultan MVP & pengembang aplikasi untuk UMKM dan startup — dari discovery sampai rilis. Juga pembuat Dotkasir, kasir Android gratis untuk warung."
>
  <section class="relative isolate -mt-14 left-1/2 w-screen -translate-x-1/2 overflow-hidden sm:-mt-16">
    <div class="hero-gradient absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <div
        class="hero-glass grid gap-8 rounded-3xl p-6 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-12 sm:p-10"
      >
        <div class="min-w-0">
          <p class="font-mono text-[11px] uppercase tracking-wider text-accent">
            {profile.name} — {consultingCopy.eyebrow}
          </p>

          <h1
            class="mt-4 text-[clamp(2.25rem,7.5vw,4.25rem)] font-semibold leading-[1.02] tracking-[-0.03em] text-balance"
          >
            {consultingCopy.headline}
          </h1>

          <p class="mt-5 max-w-[56ch] text-[clamp(1rem,1.6vw,1.15rem)] leading-relaxed text-fg-muted">
            {consultingCopy.subheadline}
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={consultationUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
            >
              {consultingCopy.ctaPrimary}
            </a>
            <a
              href="#layanan"
              class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
            >
              {consultingCopy.ctaSecondary}
            </a>
          </div>
        </div>

        <img
          src={profile.avatar}
          alt="Foto profil Aji Kamaludin, konsultan MVP dan pengembang aplikasi"
          width="176"
          height="176"
          loading="eager"
          fetchpriority="high"
          class="h-28 w-28 shrink-0 rounded-full object-cover ring-1 ring-border-control sm:h-44 sm:w-44"
        />
      </div>
    </div>
  </section>

  <section id="layanan" class="mt-10 scroll-mt-24 @container" aria-labelledby="h-layanan">
    <h2
      id="h-layanan"
      class="border-t border-border-subtle pt-5 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Layanan
    </h2>
    <div class="mt-5 grid grid-cols-1 gap-4 @md:grid-cols-2">
      {
        services.map((s, i) => (
          <article class="rounded-3xl border border-border-subtle bg-surface-raised p-6">
            <p class="font-mono text-[12px] text-accent">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-3 text-[clamp(1.05rem,2vw,1.25rem)] font-semibold tracking-tight">
              {s.title}
            </h3>
            <p class="mt-2 max-w-[52ch] text-[15px] leading-relaxed text-fg-muted">
              {s.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="proses" class="mt-20 scroll-mt-24 @container" aria-labelledby="h-proses">
    <h2
      id="h-proses"
      class="border-t border-border-subtle pt-6 text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight"
    >
      Cara kerja
    </h2>
    <ol class="mt-8 grid grid-cols-1 gap-6 @md:grid-cols-2">
      {
        processSteps.map((step, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4">
            <span class="font-mono text-[13px] font-medium text-accent tabular-nums">
              {String(i + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="text-[15px] font-medium leading-6">{step.title}</h3>
              <p class="mt-1 max-w-[52ch] text-[15px] leading-relaxed text-fg-muted">
                {step.description}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    dotkasir && (
      <section class="mt-20 @container" aria-labelledby="rilis-dotkasir">
        <div class="rounded-3xl border border-border-subtle bg-surface-raised p-6 sm:p-8">
          <div class="flex flex-col gap-6 @md:flex-row @md:items-center @md:justify-between">
            <div class="min-w-0">
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-accent">
                  <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-accent"></span>
                  Sudah rilis
                </span>
                <span class="font-mono text-[11px] uppercase tracking-wider text-fg-muted">
                  Case study · Dibangun dari nol
                </span>
              </p>
              <h2
                id="rilis-dotkasir"
                class="mt-3 text-[clamp(1.5rem,3vw,2rem)] font-semibold tracking-[-0.01em]"
              >
                {dotkasir.name}
              </h2>
              <p class="mt-1 text-[clamp(1.05rem,1.7vw,1.25rem)] font-medium text-accent">
                {dotkasir.tagline}
              </p>
              <p class="mt-3 max-w-[58ch] text-[15px] leading-relaxed text-fg-muted">
                Aplikasi kasir Android offline — dari riset kebutuhan, desain, pengembangan, sampai
                rilis di Google Play. Membuktikan kemampuan membangun produk end-to-end untuk bisnis.
              </p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-3">
              <a
                href={dotkasirDownloadUrl}
                target="_blank"
                rel="noopener"
                class="inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
              >
                Download di Google Play
              </a>
              <a
                href="/dotkasir/"
                class="inline-flex min-h-11 items-center rounded-md border border-border-control px-5 text-[15px] text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
              >
                Kenali Dotkasir
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section id="karya" class="mt-20 scroll-mt-24 @container" aria-labelledby="h-karya">
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border-subtle pt-6">
      <div class="flex items-center gap-3">
        <h2 id="h-karya" class="text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight">
          Karya
        </h2>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="karya-prev"
            aria-label="Geser ke karya sebelumnya"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-control text-fg-muted transition-colors duration-150 hover:border-accent hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            id="karya-next"
            aria-label="Geser ke karya berikutnya"
            class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border-control text-fg-muted transition-colors duration-150 hover:border-accent hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
      <a
        href="/projects/"
        class="inline-flex min-h-11 shrink-0 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
      >
        Lihat semua proyek &rarr;
      </a>
    </div>

    <p class="mt-4 max-w-[64ch] text-[15px] leading-relaxed text-fg-muted">
      Contoh aplikasi dan studi kasus sistem yang pernah saya bangun — sebagian besar dengan Laravel, Inertia.js, dan React.
      Buka proyek untuk melihat arsitektur, catatan teknis, dan akses demo.
    </p>

    <div
      id="karya-track"
      role="region"
      aria-label="Daftar karya — geser ke samping untuk melihat semua"
      tabindex="0"
      class="themed-scrollbar mt-8 flex cursor-grab gap-4 overflow-x-auto pb-3 snap-x snap-mandatory scroll-smooth [&:active]:cursor-grabbing focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
    >
      {
        karyaProjects.map((item) => (
          <article class="flex w-[min(85vw,22rem)] shrink-0 snap-start flex-col rounded-3xl border border-border-subtle bg-surface-raised p-5 sm:p-6">
            {item.data.cover && (
              <a
                href={`/projects/${item.id}/`}
                class="group mb-4 block overflow-hidden rounded-xl border border-border-subtle bg-surface-base"
                tabindex="-1"
                aria-hidden="true"
              >
                <Image
                  src={item.data.cover}
                  alt={item.data.coverAlt ?? `Screenshot antarmuka ${item.data.title}`}
                  widths={[360, 600]}
                  sizes="(max-width: 640px) 85vw, 320px"
                  class="aspect-[16/10] w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
                />
              </a>
            )}

            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1">
              <span class="rounded-full bg-accent/10 px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-accent">
                {item.data.status === "live" ? "Live Demo" : item.data.status}
              </span>
            </div>

            <h3 class="mt-2 text-[clamp(1.05rem,2vw,1.25rem)] font-semibold tracking-tight">
              <a
                href={`/projects/${item.id}/`}
                class="underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
              >
                {item.data.title}
              </a>
            </h3>

            <p class="mt-2 line-clamp-3 text-[14px] leading-relaxed text-fg-muted">
              {item.data.description}
            </p>

            {item.data.stack.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-x-2 gap-y-1 font-mono text-[11px] text-fg-muted">
                {item.data.stack.map((tech) => (
                  <span>{tech}</span>
                ))}
              </p>
            )}

            <div class="mt-auto flex flex-wrap items-center gap-3 pt-5">
              <a
                href={`/projects/${item.id}/`}
                class="inline-flex min-h-10 items-center justify-center rounded-lg bg-surface-base border border-border-control px-4 text-[13px] font-medium text-fg transition-colors duration-150 hover:border-accent hover:text-accent"
              >
                Studi kasus &rarr;
              </a>
              {item.data.demoUrl && (
                <a
                  href={item.data.demoUrl}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex min-h-10 items-center text-[13px] text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
                >
                  Live demo &#8599;
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-20" aria-labelledby="pengalaman">
    <div class="flex items-baseline justify-between gap-4 border-t border-border-subtle pt-6">
      <h2 id="pengalaman" class="text-[clamp(1.35rem,2.5vw,1.75rem)] font-semibold tracking-tight">
        Pengalaman & klien
      </h2>
      <a
        href="/about/#pengalaman"
        class="inline-flex min-h-11 shrink-0 items-center text-sm text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
      >
        Semua
      </a>
    </div>

    <ol class="mt-8 space-y-8">
      {
        recent.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="font-mono text-[13px] leading-6 text-fg-muted tabular-nums">
              {formatRange(job.start, job.end)}
            </p>
            <div>
              <p class="text-[15px] font-medium leading-6">
                {job.role}
                <span class="text-fg-muted"> · {job.company}</span>
              </p>
              <p class="mt-1 max-w-[62ch] text-[15px] leading-relaxed text-fg-muted">
                {job.highlights[0]}
              </p>
              {job.stack.length > 0 && (
                <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-[12px] text-fg-muted">
                  {job.stack.map((s) => (
                    <span>{s}</span>
                  ))}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    latestPost && (
      <section class="mt-20" aria-labelledby="konten-terbaru">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-wider text-fg-muted">
            Konten terbaru
          </p>

          <div class="mt-2 flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h2 id="konten-terbaru" class="min-w-0 text-[0.95rem] font-medium leading-snug">
              <a
                href={`/blog/${latestPost.id}/`}
                class="text-fg-muted underline-offset-4 transition-colors duration-150 hover:text-accent hover:underline"
              >
                {latestPost.data.title}
              </a>
            </h2>

            <p class="shrink-0 font-mono text-[11px] tabular-nums text-fg-muted">
              <time datetime={latestPost.data.pubDate.toISOString()}>
                {formatPublishedDate(latestPost.data.pubDate)}
                {latestPost.data.pubTime ? ` · ${latestPost.data.pubTime} WIB` : ""}
              </time>
            </p>
          </div>
        </div>
      </section>
    )
  }

  <section class="mt-20" aria-labelledby="h-cta">
    <div class="rounded-3xl border border-border-subtle bg-surface-raised p-6 sm:p-10">
      <h2
        id="h-cta"
        class="text-[clamp(1.5rem,3.5vw,2.25rem)] font-semibold tracking-tight text-balance"
      >
        Ada ide aplikasi? Mari diskusi.
      </h2>
      <p class="mt-3 max-w-[56ch] text-[15px] leading-relaxed text-fg-muted">
        Konsultasi awal gratis — ceritakan masalah bisnis Anda, lalu kita lihat apa yang bisa
        dibangun bersama. Model kerja: {engagementModel}
      </p>
      <a
        href={consultationUrl}
        target="_blank"
        rel="noopener"
        class="mt-7 inline-flex min-h-11 items-center rounded-md bg-accent px-5 text-[15px] font-medium text-surface transition-opacity duration-150 hover:opacity-90"
      >
        {consultingCopy.ctaPrimary}
      </a>
    </div>
  </section>

  <script>
    const track = document.getElementById("karya-track");
    const prevBtn = document.getElementById("karya-prev");
    const nextBtn = document.getElementById("karya-next");

    if (track) {
      const getScrollAmount = () => {
        const firstCard = track.querySelector("article");
        return firstCard ? firstCard.clientWidth + 16 : 340;
      };

      prevBtn?.addEventListener("click", () => {
        track.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
      });

      nextBtn?.addEventListener("click", () => {
        track.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
      });

      // Click-and-drag: geser dengan mouse, tapi jangan menahan klik pada tautan.
      let dragging = false;
      let startX = 0;
      let startScroll = 0;
      let moved = false;

      track.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse" || e.button !== 0) return;
        dragging = true;
        moved = false;
        startX = e.clientX;
        startScroll = track.scrollLeft;
      });

      track.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 4) {
          moved = true;
          track.scrollLeft = startScroll - dx;
        }
      });

      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
      };

      track.addEventListener("pointerup", endDrag);
      track.addEventListener("pointercancel", endDrag);
      track.addEventListener("pointerleave", endDrag);

      // Cegah klik tautan saat sedang drag.
      track.addEventListener(
        "click",
        (e) => {
          if (moved) {
            e.preventDefault();
            moved = false;
          }
        },
        true,
      );
    }
  </script>
</BaseLayout>
