---
/**
 * Island pertama — sengaja pakai <script> biasa, bukan framework.
 * Memasang React hanya untuk satu tombol tidak sepadan dengan JS bundle-nya.
 * Script-nya inline (bukan file terpisah) supaya tidak menambah request.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg border border-border-control text-fg-muted transition-colors duration-200 hover:border-accent hover:text-fg"
  aria-label="Ganti tema gelap atau terang"
>
  <svg
    class="hidden h-5 w-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"
    ></path>
  </svg>
  <svg
    class="h-5 w-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    aria-hidden="true"
  >
    <path
      d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"
      stroke-linejoin="round"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  const btn = document.getElementById('theme-toggle');

  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.classList.contains('dark') ? 'light' : 'dark';
    root.classList.toggle('dark', next === 'dark');
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Safari private mode melempar — abaikan, tema tetap berlaku untuk sesi ini */
    }
    btn.setAttribute(
      'aria-label',
      next === 'dark' ? 'Ganti ke tema terang' : 'Ganti ke tema gelap'
    );
  });
</script>
